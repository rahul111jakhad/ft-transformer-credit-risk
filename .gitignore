# --- Data and trained artifacts (heavy / private) ---
data/
artifacts/

# Note: results/ is intentionally NOT ignored — that's where committed
# paper outputs (summary tables, SHAP plots) live.

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.python-version

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Optuna study DBs ---
# The FT-Transformer Optuna study persists to a SQLite .db under artifacts/
# (already ignored). These rules also catch stray .db files elsewhere. If you
# ever want to commit a study DB for reproducibility, place it under results/
# and force-add it with `git add -f`.
*.db
*.sqlite

# --- Logs ---
*.log
